# Copy to .env and fill in. Never commit .env.

# ---- Speech to text ----
# tiny.en (fast, rough) | base.en | small.en (good default) | medium.en (best, slow)
WHISPER_MODEL=small.en
# CPU threads for speech to text. 0 = all. On a shared AllStar server, leave a core free.
WHISPER_THREADS=0
# Ignore transmissions shorter than this many seconds (kerchunks)
MIN_SECONDS=0.8
# Look up name and license class on callook.info (US calls only). 0 to turn off.
CALL_LOOKUP=1

# ---- AllStar node control (optional) ----
# Leave AMI_HOST blank to turn node control off. See docs/allstar-setup.md.
AMI_HOST=
AMI_PORT=5038
AMI_USER=netlogger
AMI_SECRET=
# The private node on your AllStar server that feeds audio to this logger
LOGGER_NODE=1999
# Node to suggest in the dashboard, e.g. your repeater's node
DEFAULT_NODE=
# 1 = connect DEFAULT_NODE automatically when the logger starts
AUTO_CONNECT=0

# ---- Web ----
HTTP_PORT=8080
USRP_PORT=34001
# 1 if you serve the dashboard over HTTPS (reverse proxy). Marks the login cookie Secure.
COOKIE_SECURE=0
# 1 if a reverse proxy (Apache, nginx, Caddy) is in front. Needed for per-person login throttling.
TRUST_PROXY=0
# How long a login lasts
SESSION_DAYS=30
